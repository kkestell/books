<% content_for :title, "Search Libgen" %>

<h1>Search Libgen in <%= @library.name %></h1>

<p>
  <%= link_to "Back to #{@library.name}", library_path(@library) %>
  <%= link_to "New search", new_library_libgen_search_path(@library) %>
</p>

<%= turbo_stream_from @libgen_search %>
<%= render "libgen_searches/search", libgen_search: @libgen_search %>
