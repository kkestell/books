<% content_for :title, "Search Libgen" %>

<h1>Search Libgen</h1>

<%= form_with url: libgen_search_path, method: :get, class: "row g-2 align-items-end mb-4" do |form| %>
  <div class="col-12 col-md-4">
    <%= form.label :author, "Author" %>
    <%= form.text_field :author, class: "form-control", value: @author, placeholder: "Author..." %>
  </div>
  <div class="col-12 col-md-4">
    <%= form.label :title, "Title" %>
    <%= form.text_field :title, class: "form-control", value: @title, placeholder: "Title..." %>
  </div>
  <div class="col-6 col-md-2">
    <%= form.label :format, "Format" %>
    <%= form.select :format,
          [ [ "Any Format", "" ] ] + LibgenSearch::SEARCH_FORMATS.map { |value| [ value, value ] },
          { selected: @format }, class: "form-select" %>
  </div>
  <div class="col-6 col-md-2">
    <%= form.submit "Search", class: "btn btn-primary w-100" %>
  </div>
<% end %>

<% if @error.present? %>
  <div class="alert alert-danger" role="alert"><%= @error %></div>
<% end %>

<% if @results %>
  <p class="text-muted"><%= pluralize(@results.size, "result") %> found</p>

  <% if @results.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th scope="col">Author</th>
            <th scope="col">Title</th>
            <th scope="col">Series</th>
            <th scope="col">Format</th>
            <th scope="col">Size</th>
            <th scope="col">Score</th>
          </tr>
        </thead>
        <tbody>
          <% @results.each do |result| %>
            <tr data-mirrors="<%= result.mirrors.join(" ") %>">
              <td title="<%= result.author %>"><%= result.author %></td>
              <td title="<%= result.title %>"><%= result.title %></td>
              <td title="<%= result.series %>"><%= result.series %></td>
              <td><%= result.format %></td>
              <td><%= result.size %></td>
              <td><%= result.score %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
