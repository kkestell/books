<% content_for :title, "Search Libgen" %>

<h1>Search Libgen in <%= @library.name %></h1>

<p><%= link_to "Back to #{@library.name}", library_path(@library) %></p>

<% if @error.present? %>
  <p role="alert"><%= @error %></p>
<% end %>

<%= form_with url: library_libgen_searches_path(@library) do |form| %>
  <p>
    <%= form.label :author, "Author" %>
    <%= form.text_field :author, placeholder: "Author..." %>
  </p>
  <p>
    <%= form.label :title, "Title" %>
    <%= form.text_field :title, placeholder: "Title..." %>
  </p>
  <p>
    <%= form.label :format, "Format" %>
    <%= form.select :format,
          [ [ "Any Format", "" ] ] + Libgen::Scraper::SEARCH_FORMATS.map { |value| [ value, value ] },
          { selected: "" } %>
  </p>
  <p><%= form.submit "Search" %></p>
<% end %>
