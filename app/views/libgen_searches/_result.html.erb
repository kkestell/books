<tr id="<%= dom_id(result) %>" data-mirrors="<%= result.mirrors.join(" ") %>">
  <td title="<%= result.author %>"><%= result.author %></td>
  <td title="<%= result.title %>"><%= result.title %></td>
  <td title="<%= result.series %>"><%= result.series %></td>
  <td><%= result.format %></td>
  <td><%= result.size %></td>
  <td><%= result.score %></td>
  <td>
    <% book_download = result.book_downloads.order(:id).last %>
    <% if book_download&.pending? || book_download&.running? %>
      <span aria-live="polite">Downloading…</span>
    <% elsif book_download&.completed? %>
      <%= link_to "In library", root_path %>
    <% elsif book_download&.failed? %>
      <%= button_to "Retry download", download_libgen_search_path(libgen_search),
            params: { result_id: result.id }, title: book_download.error %>
    <% else %>
      <%= button_to "Download", download_libgen_search_path(libgen_search),
            params: { result_id: result.id } %>
    <% end %>
  </td>
</tr>
