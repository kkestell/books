<section id="<%= dom_id(libgen_search) %>" aria-live="polite">
  <p>
    <% if libgen_search.pending? %>
      Waiting for the background searcher…
    <% elsif libgen_search.running? %>
      Searching… (<%= pluralize(libgen_search.result_count, "result") %> found)
    <% elsif libgen_search.completed? %>
      Search complete. <%= pluralize(libgen_search.result_count, "result") %> found.
    <% else %>
      Search failed: <%= libgen_search.error %>
    <% end %>
  </p>

  <% if libgen_search.results.any? %>
    <table>
      <thead>
        <tr>
          <th scope="col">Author</th>
          <th scope="col">Title</th>
          <th scope="col">Series</th>
          <th scope="col">Format</th>
          <th scope="col">Size</th>
          <th scope="col">Score</th>
          <th scope="col" aria-label="Download"></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "libgen_searches/result",
              collection: libgen_search.results.best_first,
              locals: { libgen_search: } %>
      </tbody>
    </table>
  <% elsif libgen_search.completed? %>
    <p>No results were found for that search.</p>
  <% end %>
</section>
