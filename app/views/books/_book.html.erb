<tr id="<%= dom_id(book) %>">
  <td title="<%= book.author %>"><%= book.author %></td>
  <td title="<%= book.title %>"><%= link_to book.title, edit_book_path(book) %></td>
  <td title="<%= series_label(book) %>" data-filter-value="<%= book.series %>"><%= series_label(book) %></td>
  <td title="<%= book.published %>" data-filter-value="<%= book.published&.year %>"><%= book.published %></td>
  <td title="<%= book.book_type %>"><%= book.book_type %></td>
  <td title="<%= book.format %>"><%= book.format %></td>
  <td title="<%= book.created_at.to_date %>"><%= book.created_at.to_date %></td>
  <td>
    <% if book.file.attached? %>
      <%= link_to download_label(book), rails_blob_path(book.file, disposition: "attachment") %>
    <% end %>
  </td>
</tr>
