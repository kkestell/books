<% content_for :title, @library.name %>

<header>
  <h1><%= @library.name %></h1>
  <nav>
    <%= link_to "All libraries", libraries_path %>
    <%= link_to "Search Libgen", new_library_libgen_search_path(@library) %>
    <%= link_to "Import ebooks", new_library_book_import_path(@library) %>
  </nav>
</header>

<% if notice.present? %>
  <p role="status"><%= notice %></p>
<% end %>

<% if alert.present? %>
  <p role="alert"><%= alert %></p>
<% end %>

<table>
  <thead>
    <tr>
      <th scope="col">Author</th>
      <th scope="col">Title</th>
      <th scope="col">Series</th>
      <th scope="col">#</th>
      <th scope="col">Published</th>
      <th scope="col">Type</th>
      <th scope="col">Format</th>
      <th scope="col">Added</th>
      <th scope="col">Download</th>
    </tr>
  </thead>
  <tbody>
    <% @books.each do |book| %>
      <tr>
        <td title="<%= book.author %>"><%= book.author %></td>
        <td title="<%= book.title %>"><%= link_to book.title, edit_library_book_path(@library, book) %></td>
        <td title="<%= book.series %>"><%= book.series %></td>
        <td title="<%= book.series_number %>"><%= book.series_number %></td>
        <td title="<%= book.published %>"><%= book.published %></td>
        <td title="<%= book.book_type %>"><%= book.book_type %></td>
        <td title="<%= book.format %>"><%= book.format %></td>
        <td title="<%= book.created_at.to_date %>"><%= book.created_at.to_date %></td>
        <td>
          <% if book.file.attached? %>
            <% if book.format.to_s.casecmp?("pdf") %>
              <%= link_to "pdf", rails_blob_path(book.file, disposition: "attachment") %>
            <% else %>
              <%= link_to "azw3", download_library_book_path(@library, book) %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
