<% content_for :title, @library.name %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <h1 class="mb-0"><%= @library.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "All libraries", libraries_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Import ebooks", new_library_book_import_path(@library), class: "btn btn-primary" %>
  </div>
</div>

<% if notice.present? %>
  <div class="alert alert-success" role="status"><%= notice %></div>
<% end %>

<div class="table-responsive w-100">
  <table class="table table-striped table-hover align-middle w-100 mb-0">
    <thead>
      <tr>
        <th scope="col">Author</th>
        <th scope="col">Title</th>
        <th scope="col">Series</th>
        <th scope="col">#</th>
        <th scope="col">Published</th>
        <th scope="col">Type</th>
        <th scope="col">Format</th>
        <th scope="col">File</th>
        <th scope="col">Added</th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= book.author %></td>
          <td><%= book.title %></td>
          <td><%= book.series %></td>
          <td><%= book.series_number %></td>
          <td><%= book.published %></td>
          <td><%= book.book_type %></td>
          <td><%= book.format %></td>
          <td>
            <% if book.file.attached? %>
              <%= link_to book.file.filename, rails_blob_path(book.file, disposition: "attachment") %>
            <% end %>
          </td>
          <td><%= book.created_at.to_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
