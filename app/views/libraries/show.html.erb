<% content_for :title, @library.name %>

<header>
  <h1><%= @library.name %></h1>
  <nav>
    <%= link_to "Downloads", downloads_path %>
    <%= link_to "Search Libgen", new_libgen_search_path %>
    <%= link_to "Import ebooks", new_book_import_path %>
  </nav>
</header>

<% if notice.present? %>
  <p role="status"><%= notice %></p>
<% end %>

<% if alert.present? %>
  <p role="alert"><%= alert %></p>
<% end %>

<%= turbo_stream_from current_user.library %>

<table class="library" border="1" data-controller="table-filter">
  <thead data-action="input->table-filter#filter">
    <tr>
      <th scope="col">
        <input type="text" list="library-filter-author" placeholder="Author" aria-label="Filter by author" data-table-filter-target="filter">
        <datalist id="library-filter-author"></datalist>
      </th>
      <th scope="col" class="title">
        <input type="search" placeholder="Title" aria-label="Filter by title" data-table-filter-target="filter">
      </th>
      <th scope="col">
        <input type="text" list="library-filter-series" placeholder="Series" aria-label="Filter by series" data-table-filter-target="filter">
        <datalist id="library-filter-series"></datalist>
      </th>
      <th scope="col">
        <input type="text" list="library-filter-published" placeholder="Published" aria-label="Filter by publication date" data-table-filter-target="filter">
        <datalist id="library-filter-published"></datalist>
      </th>
      <th scope="col">
        <input type="text" list="library-filter-book-type" placeholder="Type" aria-label="Filter by type" data-table-filter-target="filter">
        <datalist id="library-filter-book-type"></datalist>
      </th>
      <th scope="col">
        <input type="text" list="library-filter-format" placeholder="Format" aria-label="Filter by format" data-table-filter-target="filter">
        <datalist id="library-filter-format"></datalist>
      </th>
      <th scope="col">
        <input type="text" list="library-filter-added" placeholder="Added" aria-label="Filter by date added" data-table-filter-target="filter">
        <datalist id="library-filter-added"></datalist>
      </th>
      <th scope="col">Download</th>
    </tr>
  </thead>
  <tbody>
    <%= render @books %>
  </tbody>
</table>
