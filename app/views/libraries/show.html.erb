<% content_for :title, @library.name %>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <h1 class="mb-0"><%= @library.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "All libraries", libraries_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Import ebooks", new_library_book_import_path(@library), class: "btn btn-primary" %>
  </div>
</div>

<% if notice.present? %>
  <div class="alert alert-success" role="status"><%= notice %></div>
<% end %>

<div data-controller="context-menu"
     data-action="click@window->context-menu#close contextmenu@window->context-menu#close keydown.esc@window->context-menu#close resize@window->context-menu#close scroll@window->context-menu#close">
  <div class="table-responsive w-100">
    <table class="table table-striped table-hover align-middle w-100 mb-0 library-books">
      <colgroup>
        <col class="library-books__author">
        <col class="library-books__title">
        <col class="library-books__series">
        <col class="library-books__series-number">
        <col class="library-books__published">
        <col class="library-books__type">
        <col class="library-books__format">
        <col class="library-books__added">
      </colgroup>
      <thead>
        <tr>
          <th scope="col">Author</th>
          <th scope="col">Title</th>
          <th scope="col">Series</th>
          <th scope="col">#</th>
          <th scope="col">Published</th>
          <th scope="col">Type</th>
          <th scope="col">Format</th>
          <th scope="col">Added</th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr<% if book.file.attached? %>
                tabindex="0"
                data-action="contextmenu->context-menu#open"
                data-context-menu-download-url="<%= rails_blob_path(book.file, disposition: "attachment") %>"
              <% end %>>
            <td title="<%= book.author %>"><%= book.author %></td>
            <td title="<%= book.title %>"><%= book.title %></td>
            <td title="<%= book.series %>"><%= book.series %></td>
            <td title="<%= book.series_number %>"><%= book.series_number %></td>
            <td title="<%= book.published %>"><%= book.published %></td>
            <td title="<%= book.book_type %>"><%= book.book_type %></td>
            <td title="<%= book.format %>"><%= book.format %></td>
            <td title="<%= book.created_at.to_date %>"><%= book.created_at.to_date %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="context-menu" data-context-menu-target="menu" role="menu" aria-label="Book actions" hidden>
    <a class="context-menu__item" data-context-menu-target="download" role="menuitem" download>Download</a>
  </div>
</div>
